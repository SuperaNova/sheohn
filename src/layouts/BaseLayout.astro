---
import '../styles/global.css';
import HeaderNav from '../components/chrome/HeaderNav.svelte';
import Loader from '../components/chrome/Loader.svelte';
import NavProgress from '../components/chrome/NavProgress.svelte';
import ScrollProgress from '../components/chrome/ScrollProgress.svelte';
import CustomCursor from '../components/chrome/CustomCursor.svelte';
import RumCollector from '../components/chrome/RumCollector.svelte';
import ScenePilot from '../components/agent/ScenePilot.svelte';
import CommandDeck from '../components/agent/CommandDeck.svelte';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { personalInfo } from '../data/personalInfo';
// Build-time only (boot-data pulls in node:child_process); never imported by client code.
import { getBootInfo } from '../lib/boot-data';

const bootInfo = getBootInfo();

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = `Portfolio of ${personalInfo.name} - ${personalInfo.title}.`,
  image = '/og/home.png',
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || 'https://sheohn.dev',
);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Mobile browser-chrome color, synced with the theme by the inline script and store.ts. -->
    <meta name="theme-color" content="#f3efe8" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: personalInfo.name,
        url: 'https://sheohn.dev',
        jobTitle: personalInfo.title,
        sameAs: [personalInfo.socials.github, personalInfo.socials.linkedin],
      })}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: `${personalInfo.name} Portfolio`,
        url: 'https://sheohn.dev',
      })}
    />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />

    <script is:inline>
      function applyThemeAndLoader() {
        // Opt in to scroll-reveal start states only with JS; no-JS and headless renders stay visible.
        document.documentElement.classList.add('js-reveal');

        const isLocalAudit =
          window.location.hostname === 'localhost' ||
          window.location.hostname === '127.0.0.1';
        const urlTheme = isLocalAudit
          ? new URLSearchParams(window.location.search).get('theme')
          : null;
        const override =
          urlTheme === 'light' || urlTheme === 'dark' ? urlTheme : null;
        // Default to light on first visit; returning users keep their stored choice (OS preference ignored).
        const theme = override || localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        const themeColorMeta = document.querySelector(
          'meta[name="theme-color"]',
        );
        if (themeColorMeta) {
          themeColorMeta.setAttribute(
            'content',
            theme === 'dark' ? '#050505' : '#f3efe8',
          );
        }

        // 2. Prevent Loader from playing multiple times per session
        if (sessionStorage.getItem('loader-played')) {
          document.documentElement.classList.add('skip-loader');
        } else {
          sessionStorage.setItem('loader-played', 'true');
        }
      }

      applyThemeAndLoader();

      // Run on every page navigation (Astro View Transitions)
      document.addEventListener('astro:after-swap', applyThemeAndLoader);

      // Scroll to top before the DOM swap so new pages start at 0.
      document.addEventListener('astro:before-swap', () =>
        window.scrollTo(0, 0),
      );
    </script>
  </head>

  <body
    class="relative selection:bg-[color-mix(in_srgb,var(--color-primary)_42%,transparent)] selection:text-slate-100"
  >
    <!-- Console boot screen: plays once per session (the head script hides it on return visits). -->
    <Loader client:load {bootInfo} />

    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div
        class="absolute -top-[20%] -left-[10%] h-[50%] w-[50%] rounded-full bg-[var(--color-tertiary)] opacity-[0.06] blur-[120px] dark:opacity-[0.10]"
      >
      </div>
      <div
        class="absolute top-[60%] -right-[10%] h-[60%] w-[50%] rounded-full bg-[var(--color-tertiary)] opacity-[0.04] blur-[120px] dark:opacity-[0.08]"
      >
      </div>
    </div>

    <!-- Static film grain, viewport-sized; overflow-hidden stops tile bleed on mobile. -->
    <div
      class="pointer-events-none fixed inset-0 z-50 overflow-hidden opacity-[0.08] mix-blend-multiply invert dark:opacity-[0.25] dark:mix-blend-overlay dark:invert-0"
    >
      <div class="site-noise absolute inset-0"></div>
    </div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[1000] focus:rounded-md focus:bg-[var(--color-tertiary)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      Skip to main content
    </a>

    <NavProgress client:idle transition:persist />
    <ScrollProgress client:idle transition:persist />
    <CustomCursor client:idle transition:persist />
    <ScenePilot client:idle transition:persist />
    <!-- RUM collector island: runs once and stays mounted via transition:persist. -->
    <RumCollector client:idle transition:persist />
    <HeaderNav client:load transition:persist />

    <!-- pb leaves a scroll runway so the docked deck never covers the last content. -->
    <div id="main-content" class="pb-28">
      <slot />
    </div>

    <!-- Command deck; transition:persist keeps the conversation alive across agent navigation. -->
    <CommandDeck client:idle transition:persist {bootInfo} />

    <Analytics />
    <SpeedInsights />
  </body>
</html>
