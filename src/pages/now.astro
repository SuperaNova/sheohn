---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionReveal from '../components/ui/SectionReveal.svelte';
import { firstName } from '../data/personalInfo';
import { now } from '../data/now';

const updatedLabel = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date(now.updated));
---

<BaseLayout
  title="Now"
  description={`What ${firstName} is working on, studying and thinking about right now.`}
  image="/og/now.png"
>
  <main class="relative isolate min-h-screen bg-[var(--color-surface)] pt-32">
    <!-- dark-mode scene echo; `isolate` on <main> scopes its z-index -->
    <div class="subpage-scene-echo" aria-hidden="true"></div>
    <SectionReveal
      client:visible
      id="now"
      class="content-wrap relative z-10 flex scroll-mt-24 flex-col bg-transparent pb-24"
    >
      <h2
        class="font-display text-4xl text-[var(--color-on-surface)] sm:text-5xl"
      >
        Now
      </h2>
      <p class="mt-4 leading-[1.6] text-[var(--color-on-surface-muted)]">
        What I'm up to these days. Updated <time datetime={now.updated}
          >{updatedLabel}</time
        >.
      </p>

      <div class="mt-12 flex max-w-2xl flex-col gap-10">
        {
          now.sections.map((section) => (
            <section>
              <p class="readout">{section.heading}</p>
              <ul class="mt-4 flex flex-col gap-3 leading-[1.6] text-[var(--color-on-surface-muted)]">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <p class="mt-16 text-sm text-[var(--color-on-surface-muted)]">
        This is a <a
          href="https://nownownow.com/about"
          rel="noopener"
          class="underline-offset-4 transition hover:text-[var(--color-on-surface)] hover:underline"
          >now page</a
        >.
      </p>
    </SectionReveal>
  </main>
</BaseLayout>
