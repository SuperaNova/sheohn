---
// SSR: each route's stats are a live Redis read at request time. getRouteStats
// fails open internally, so an unreachable/empty Redis renders empty states
// instead of a 500.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionReveal from '../components/ui/SectionReveal.svelte';
import { getCollection } from 'astro:content';
import { buildKnownRoutes, STATIC_ROUTES } from '../lib/rum-routes';
import { getRouteStats, type RouteStats } from '../lib/rum-redis';

let knownRoutes: string[] = [...STATIC_ROUTES];
try {
  const projects = await getCollection('projects');
  knownRoutes = buildKnownRoutes(projects.map((p) => ({ id: p.id })));
} catch (err) {
  console.error('[stats] failed to resolve known routes:', err);
}

const routeStats: { route: string; stats: RouteStats }[] = await Promise.all(
  knownRoutes.map(async (route) => ({
    route,
    stats: await getRouteStats(route),
  })),
);

const totalPageviews = routeStats.reduce(
  (sum, r) => sum + r.stats.pageviews,
  0,
);

function fmtMs(n: number): string {
  return n > 0 ? `${Math.round(n)}ms` : '—';
}

function fmtCls(n: number): string {
  return n > 0 ? n.toFixed(3) : '—';
}
---

<BaseLayout
  title="Stats"
  description="Self-built field performance monitoring — real pageviews and Core Web Vitals percentiles per route, no vendor RUM script."
>
  <main class="relative isolate min-h-screen bg-[var(--color-surface)] pt-32">
    <!-- dark-mode scene echo; `isolate` on <main> scopes its z-index -->
    <div class="subpage-scene-echo" aria-hidden="true"></div>

    <SectionReveal
      client:visible
      id="stats-intro"
      class="content-wrap relative z-10 flex scroll-mt-24 flex-col bg-transparent pb-12"
    >
      <span class="readout">Field Performance</span>
      <h2
        class="font-display mt-4 text-4xl text-[var(--color-on-surface)] sm:text-5xl"
      >
        Stats
      </h2>
      <p
        class="mt-6 max-w-2xl text-lg leading-[1.6] text-[var(--color-on-surface)]"
      >
        A hand-rolled RUM collector — PerformanceObserver for LCP/CLS/INP plus a
        pageview beacon, posted anonymously via <code>sendBeacon</code> — no vendor
        script, no IP or cookie ever stored.
      </p>
    </SectionReveal>

    <SectionReveal
      client:visible
      id="stats-routes"
      class="content-wrap relative z-10 flex scroll-mt-24 flex-col border-t border-[var(--color-outline-variant)] bg-transparent py-16"
    >
      <div class="mb-10 flex items-end justify-between gap-6">
        <h2
          class="font-display text-3xl text-[var(--color-on-surface)] sm:text-4xl"
        >
          Per-Route Percentiles
        </h2>
        <span class="readout">Trailing 14 Days</span>
      </div>
      <p class="max-w-2xl text-[var(--color-on-surface-muted)]">
        {totalPageviews} pageviews recorded across {routeStats.length} known routes.
      </p>

      <div
        class="mt-10 flex flex-col gap-px overflow-hidden rounded-xl border border-[var(--color-console-line)] bg-[var(--color-console-line)]"
      >
        {
          routeStats.map(({ route, stats }) => (
            <div class="bg-[var(--color-console-surface)] p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-4">
                <p class="font-mono text-sm text-[var(--color-console-signal)]">
                  {route}
                </p>
                <p class="font-mono text-xs text-[var(--color-console-text-dim)]">
                  {stats.pageviews} pageviews
                </p>
              </div>
              {stats.pageviews === 0 ? (
                <p class="mt-4 font-mono text-xs text-[var(--color-console-text-dim)]">
                  No data recorded yet.
                </p>
              ) : (
                <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                  <div>
                    <p class="font-mono text-[11px] tracking-wide text-[var(--color-console-text-dim)] uppercase">
                      LCP
                    </p>
                    <p class="mt-1 font-mono text-xs text-[var(--color-on-surface-muted)]">
                      p50 {fmtMs(stats.percentiles.lcp.p50)} · p75{' '}
                      {fmtMs(stats.percentiles.lcp.p75)} · p95{' '}
                      {fmtMs(stats.percentiles.lcp.p95)}
                    </p>
                  </div>
                  <div>
                    <p class="font-mono text-[11px] tracking-wide text-[var(--color-console-text-dim)] uppercase">
                      CLS
                    </p>
                    <p class="mt-1 font-mono text-xs text-[var(--color-on-surface-muted)]">
                      p50 {fmtCls(stats.percentiles.cls.p50)} · p75{' '}
                      {fmtCls(stats.percentiles.cls.p75)} · p95{' '}
                      {fmtCls(stats.percentiles.cls.p95)}
                    </p>
                  </div>
                  <div>
                    <p class="font-mono text-[11px] tracking-wide text-[var(--color-console-text-dim)] uppercase">
                      INP
                    </p>
                    <p class="mt-1 font-mono text-xs text-[var(--color-on-surface-muted)]">
                      p50 {fmtMs(stats.percentiles.inp.p50)} · p75{' '}
                      {fmtMs(stats.percentiles.inp.p75)} · p95{' '}
                      {fmtMs(stats.percentiles.inp.p95)}
                    </p>
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </SectionReveal>
  </main>
</BaseLayout>
